# Copy to .env and fill in before running setup.sh (or let setup.sh generate the secret).
DESK_DOMAIN=desk.trydesk.ai.id
TURN_DOMAIN=turn.trydesk.ai.id
# Leave blank to let setup.sh generate a strong secret with: openssl rand -hex 32
TURN_SECRET=
# 8443 (HTTPS-alt) passes most ISP firewalls; 3478 is often blocked
TURN_PORT=8443
# Optional: oldest TryDesk version allowed to connect (e.g. 1.3.1). Older apps are told to update and refused.
# Leave blank for no check. Only raise it once that version is downloadable.
MIN_CLIENT_VERSION=
